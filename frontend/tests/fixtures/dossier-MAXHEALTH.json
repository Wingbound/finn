 "snapshot": {
  "summary": [
   {
    "text": "Max Healthcare Institute Limited operates a network of hospitals providing quality healthcare services, with strong demand reflected in steady occupancy across its facilities.",
    "citation": {
     "source_id": "T1",
     "page": 2,
     "quote": "Demand for quality healthcare remains strong across the hospital Network, with occupancy holding steady at 77%"
    }
   },
   {
    "text": "The company engages in brownfield expansions to add bed capacity at existing hospitals, such as Max Noida, Max Vaishali, and BLK-Max.",
    "citation": {
     "source_id": "T1",
     "page": 3,
     "quote": "In this regard, the Board has approved an investment of INR 415 crore towards addition of 209 brownfield beds at Max Noida, Max Vaishali and BLK-Max, along with a multi-level car park (MLCP) tower at BLK at the cost of approximately INR 85 crore."
    }
   },
   {
    "text": "Max Healthcare provides specialized medical services, including oncology, with new facilities like the oncology block at Max Dwarka enabling further service additions.",
    "citation": {
     "source_id": "T1",
     "page": 3,
     "quote": "Services have also commenced at the new oncology block at Max Dwarka, wh ich will enable addition of around 20 beds to the hospital in Q3 FY27."
    }
   }
  ]
 },
