 "snapshot": {
  "summary": [
   {
    "text": "UltraTech Cement Limited operates in the cement industry, generating revenue through cement sales across various regional markets in India such as North, South, West, East, and Central.",
    "citation": {
     "source_id": "T1",
     "page": 3,
     "quote": "If you were to split the realizations by zone for the quarter, West, the prices were steady through July and August, stepped up in September with Mumbai being the biggest market moving strongly up by 3% to 4% per bag for both bag and bulk."
    }
   },
   {
    "text": "The company engages in expanding its production capabilities, exemplified by commissioning a greenfield cement capacity in the Southern markets during the quarter.",
    "citation": {
     "source_id": "T1",
     "page": 4,
     "quote": "This quarter, we have commissioned a greenfield cement capacity in the Southern markets."
    }
   }
  ]
 },
